# Copy this file to infra/.env and fill in real values -- docker compose
# reads infra/.env automatically (it lives next to docker-compose.yml) to
# substitute the ${GREENPROJECT_...} variables in docker-compose.yml.
# Running the backend without Docker? Put the same lines into .env in the
# repository root instead (uvicorn is started from there).
#
# Юна (the in-app chat assistant, backend/app/services/assistant_service.py)
# talks to any OpenAI-compatible chat completions endpoint with tool calling.
# Everything below is optional: with nothing set, Юна still works -- she
# answers with the built-in command parser ("базовый режим",
# assistant_rules.py), which understands the common requests (explain the
# plan, sparser/denser, rows, trees in paving, select, delete selected,
# export). A model adds free-form questions on top. Pick ONE setup.
#
# GET http://localhost:8000/api/config/assistant shows which one is live.

# --- 1. Selectel AI Gateway, GLM-5.3 Flash (the default endpoint) -----------
# Only the key is needed: https://my.selectel.ru -> AI Gateway -> API keys.
# Base URL and model are the defaults; the model must be z-ai/glm-5.3-flash,
# not selectel/glm-5.3-flash -- only the first one has tool calling
# (capabilities in GET https://api.selectel.ru/aig/v1/models).
GREENPROJECT_LLM_API_KEY=
# GREENPROJECT_LLM_BASE_URL=https://api.selectel.ru/aig/v1
# GREENPROJECT_LLM_MODEL=z-ai/glm-5.3-flash
# Sent as reasoning_effort; unset means "low" for Selectel (2-3 s per answer
# instead of 5-6 s, the same tool calls). "off" never sends the field.
# GREENPROJECT_LLM_REASONING_EFFORT=low

# --- 2. Local Ollama, no key, nothing leaves the machine ---------------------
# ollama pull qwen3:8b   (any model with tool support)
# From inside Docker the host is host.docker.internal (Docker Desktop on
# macOS/Windows). On Linux also add to the backend service in
# docker-compose.yml:  extra_hosts: ["host.docker.internal:host-gateway"]
# and start Ollama with OLLAMA_HOST=0.0.0.0. Running the backend without
# Docker? Use http://localhost:11434/v1 instead.
# GREENPROJECT_LLM_BASE_URL=http://host.docker.internal:11434/v1
# GREENPROJECT_LLM_MODEL=qwen3:8b
# A local model on CPU can take a while per answer (default 45 s):
# GREENPROJECT_LLM_TIMEOUT_S=90

# --- 3. Groq (free tier) -------------------------------------------------------
# Key: https://console.groq.com. Model ids there change without notice --
# check GET https://api.groq.com/openai/v1/models if Юна starts failing.
# GREENPROJECT_LLM_BASE_URL=https://api.groq.com/openai/v1
# GREENPROJECT_LLM_MODEL=openai/gpt-oss-20b
# GREENPROJECT_LLM_API_KEY=
# The key's old name still works on its own and still means Groq:
# GREENPROJECT_GROQ_API_KEY=

# --- Сервер с публичным адресом ---------------------------------------------
# Браузер открывает http://<IP>:3000 и ходит в API на http://<IP>:8000, поэтому
# бэкенду нужно разрешить этот адрес страницы (CORS). Точки экранировать.
# В группе безопасности облака открыть порты 3000 и 8000.
# GREENPROJECT_CORS_ORIGIN_REGEX=^http://51\.250\.1\.2:3000$

# --- Сервер с доменом и HTTPS (infra/docker-compose.prod.yml + Caddyfile) ----
# Запуск: docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml up -d --build
# Наружу открыты только 80 и 443, CORS не нужен: фронт и API на одном адресе.
# GREENPROJECT_DOMAIN=greenproject.space
