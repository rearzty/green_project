# Copy this file to infra/.env and fill in real values -- docker compose
# reads infra/.env automatically (it lives next to docker-compose.yml) to
# substitute the ${GREENPROJECT_GROQ_API_KEY} in docker-compose.yml.

# Юна (the in-app chat assistant, backend/app/services/assistant_service.py)
# needs a free Groq API key to turn chat messages into generation-setting
# changes. Get one at https://console.groq.com (free tier). Leave empty to
# leave Юна disabled -- the rest of the app works fine without it.
GREENPROJECT_GROQ_API_KEY=
